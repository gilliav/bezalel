rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Anonymous sign-in is enabled for the public course catalog, so
    // isAuthenticated() alone is no longer a meaningful identity bar.
    // Destructive cohort writes require a real (non-anonymous) sign-in.
    function isNonAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // users: each user can read/write only their own document
    // role field is excluded from client writes (Admin SDK only)
    match /users/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);
      allow create: if isAuthenticated() && isOwner(uid)
        && !request.resource.data.keys().hasAny(['role']);
      allow update: if isAuthenticated() && isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // courses: any authenticated user can read; only admins can write
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // catalogCourses: any authenticated user (including anonymous) can read;
    // no client writes — seeded via Admin SDK only (src/seed/seedCatalog.js)
    match /catalogCourses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // catalogRatings: any authenticated user can read (needed for aggregate
    // stats); a user may only create/update their own rating doc, whose ID
    // must be `${uid}_${courseCode}` — this is the dedup mechanism
    match /catalogRatings/{ratingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && ratingId == request.auth.uid + '_' + request.resource.data.courseCode
        && request.resource.data.status in ['rated', 'notTaken']
        && (!('comment' in request.resource.data) || request.resource.data.comment.size() <= 1000);
      allow delete: if false;
    }

    // cohorts: any authenticated user can read; no client writes
    match /cohorts/{cohortId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // projects: anyone can read/create; destructive writes require a real
    // (non-anonymous) sign-in — see isNonAnonymous()
    match /projects/{projectId} {
      allow read, create: if true;
      allow update, delete: if isNonAnonymous();

      // milestones subcollection
      match /milestones/{milestoneId} {
        allow read: if true;
        allow create, update, delete: if isNonAnonymous();
      }

      // attachments subcollection
      match /attachments/{attachmentId} {
        allow read: if isAuthenticated();
        allow create: if isNonAnonymous();
        allow update, delete: if isNonAnonymous();
      }
    }

    // milestones collectionGroup query (used by useMilestones hook)
    match /{path=**}/milestones/{milestoneId} {
      allow read: if true;
    }

    // progress: users can only read/write their own progress records
    match /progress/{progressId} {
      allow read, write: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }
  }
}
